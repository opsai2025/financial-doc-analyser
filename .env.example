# =====================================================================
#  Copy this file to `.env` and fill in the values.  `.env` is git-ignored.
#  Setup guide: docs/SETUP.md
#  NOTE: LLM providers, models and API keys are NOT configured here —
#        they are managed inside the app (Admin panel / user profile).
# =====================================================================

# ----- Environment ----------------------------------------------------
# development | production
APP_ENV=development
LOG_LEVEL=INFO

# ----- Database (Supabase Postgres) -------------------------------------
# Use the "Session pooler" connection string (works over IPv4):
#   Supabase Dashboard -> Connect -> Session pooler
# Replace the "postgresql://" prefix with "postgresql+psycopg://".
# Example:
#   postgresql+psycopg://postgres.<project-ref>:<DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Leave EMPTY to use a local SQLite file (data/local.db) for offline development.
DATABASE_URL=

# ----- File storage for uploaded PDFs (Supabase Storage) ----------------
# Project URL:  Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=
# Secret / service_role key (server-side only — never share or commit it)
SUPABASE_SERVICE_KEY=
# Private bucket name (created automatically on first run if missing)
SUPABASE_STORAGE_BUCKET=audit-pdfs
# Used only when SUPABASE_URL is empty
LOCAL_STORAGE_DIR=data/storage

# ----- Security ---------------------------------------------------------
# Signs login session cookies. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
# Encrypts LLM API keys stored in the database (Fernet). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: if this key is lost or changed, stored API keys can no longer be decrypted.
APP_ENCRYPTION_KEY=

# ----- Bootstrap admin (created on first run only if no admin exists) ---
ADMIN_USERNAME=admin
# Temporary password; you will be forced to change it at first login.
ADMIN_INITIAL_PASSWORD=

# ----- Sessions & guests ------------------------------------------------
SESSION_HOURS=8
# How long a guest's in-memory results stay available for download
GUEST_RESULT_TTL_MINUTES=120

# ----- Optional: real-provider end-to-end test (development only) --------
# Used only by the E2E check; regular providers are configured in the app.
# TEST_PROVIDER_TYPE: gemini | openai_compatible | anthropic
TEST_PROVIDER_TYPE=
TEST_BASE_URL=
TEST_API_KEY=
TEST_MODEL=
